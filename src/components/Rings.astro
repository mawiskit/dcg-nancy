---
// Motif secondaire : trois cercles entrelacés (en contour, couleur courante).
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 60 56" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.4" vector-effect="non-scaling-stroke">
    <circle cx="21" cy="21" r="17" vector-effect="non-scaling-stroke" />
    <circle cx="39" cy="21" r="17" vector-effect="non-scaling-stroke" />
    <circle cx="30" cy="35" r="17" vector-effect="non-scaling-stroke" />
  </g>
</svg>
