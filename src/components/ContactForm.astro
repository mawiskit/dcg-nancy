---
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { id = 'cf' } = Astro.props;
---
<form class="cform" method="post" data-endpoint={endpoint}>
  <input type="hidden" name="_subject" value="Contact – site DCG Nancy" />
  <p class="cform-trap" aria-hidden="true"><label>Ne pas remplir <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>

  <div class="cform-row">
    <p><label for={`${id}-nom`}>Nom et prénom</label><input id={`${id}-nom`} name="nom" type="text" autocomplete="name" required /></p>
    <p><label for={`${id}-mail`}>Adresse e-mail</label><input id={`${id}-mail`} name="email" type="email" autocomplete="email" required /></p>
  </div>
  <p>
    <label for={`${id}-profil`}>Vous êtes</label>
    <select id={`${id}-profil`} name="profil">
      <option>Lycéen(ne)</option>
      <option>Étudiant(e) en réorientation</option>
      <option>Parent</option>
      <option>Autre</option>
    </select>
  </p>
  <p><label for={`${id}-msg`}>Votre message</label><textarea id={`${id}-msg`} name="message" rows="5" required></textarea></p>
  <p class="cform-check">
    <input id={`${id}-ok`} name="consentement" type="checkbox" value="oui" required />
    <label for={`${id}-ok`}>J’accepte que ces informations soient utilisées pour répondre à ma demande. <a href={`${base}/confidentialite/`}>Politique de confidentialité</a></label>
  </p>
  <div class="cform-foot">
    <button type="submit" class="cform-send">Envoyer le message</button>
    <p class="cform-status" role="status" aria-live="polite"></p>
  </div>
</form>
<script is:inline>
  (function () {
    document.querySelectorAll('form.cform').forEach(function (f) {
      var st = f.querySelector('.cform-status');
      var btn = f.querySelector('button[type=submit]');
      function say(t, bad) { st.textContent = t; st.classList.toggle('bad', !!bad); }
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (f.elements._gotcha && f.elements._gotcha.value) return;
        var ep = f.getAttribute('data-endpoint');
        if (!ep) { say('Le formulaire n’est pas encore relié à une messagerie. Merci de réessayer bientôt.', true); return; }
        btn.disabled = true; say('Envoi en cours…');
        fetch(ep, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } })
          .then(function (r) {
            if (!r.ok) throw new Error('http ' + r.status);
            f.reset(); say('Merci, votre message est bien envoyé.');
          })
          .catch(function () { say('L’envoi a échoué. Réessayez dans un instant.', true); })
          .then(function () { btn.disabled = false; });
      });
    });
  })();
</script>
