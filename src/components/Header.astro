---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { label: 'Découvrir', href: '/decouvrir-le-dcg/' },
  { label: 'Pourquoi nous ?', href: '/pourquoi-nous-choisir/' },
  { label: 'Après le DCG ?', href: '/poursuites-etudes-carrieres/' },
  { label: 'Vie étudiante', href: '/vie-etudiante/' },
  { label: 'Témoignages', href: '/temoignages/' },
  { label: 'Admissions', href: '/admissions/' },
];
---
<header class="site-header">
  <a class="brand" href={`${base}/`} aria-label="DCG Nancy, lycée Georges-de-la-Tour, accueil">
    <img src={`${base}/images/logo-dcg-nancy.png`} width="64" height="64" alt="" />
    <span><b>DCG Nancy</b><small>Lycée Georges-de-la-Tour</small></span>
  </a>
  <div class="header-right">
    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        {nav.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="cta" href={`${base}/admissions/`}>CANDIDATER</a>
    <details class="burger">
      <summary aria-label="Menu"><span></span></summary>
      <nav aria-label="Navigation mobile">
        <ul>
          {nav.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
