---
import ContactForm from './ContactForm.astro';
---
<dialog id="contact-dialog" class="cdialog" aria-labelledby="cd-title">
  <div class="cdialog-in">
    <button type="button" class="cdialog-close" aria-label="Fermer le formulaire">×</button>
    <h2 id="cd-title">Une question sur le DCG ?</h2>
    <p class="cdialog-lead">Écrivez-nous, nous vous répondons rapidement.</p>
    <ContactForm id="d" />
  </div>
</dialog>
<script is:inline>
  (function () {
    var d = document.getElementById('contact-dialog');
    if (!d || typeof d.showModal !== 'function') return;
    document.querySelectorAll('[data-open-contact]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); d.showModal(); });
    });
    d.querySelector('.cdialog-close').addEventListener('click', function () { d.close(); });
    d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
  })();
</script>
