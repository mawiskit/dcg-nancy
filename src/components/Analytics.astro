---
// Google Analytics 4, chargé uniquement après consentement explicite.
// Sans PUBLIC_GA_ID, ce composant n'affiche rien.
const id = import.meta.env.PUBLIC_GA_ID;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{id && (
  <>
    <div id="cookie-banner" class="cookies" role="dialog" aria-labelledby="cookie-title" hidden>
      <p id="cookie-title">
        Ce site utilise Google Analytics pour mesurer son audience. Aucun cookie de mesure n’est déposé sans votre accord.
        <a href={`${base}/confidentialite/`}>En savoir plus</a>
      </p>
      <div class="cookies-actions">
        <button type="button" data-consent="refuse">Refuser</button>
        <button type="button" data-consent="accept">J’accepte les cookies</button>
      </div>
    </div>
    <script is:inline define:vars={{ id }}>
      (function () {
        var KEY = 'dcg-consent';
        var box = document.getElementById('cookie-banner');
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', id, { anonymize_ip: true });
        }
        function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
        var saved = null;
        try { saved = localStorage.getItem(KEY); } catch (e) {}
        if (saved === 'accept') load();
        else if (saved !== 'refuse') box.hidden = false;
        box.addEventListener('click', function (e) {
          var b = e.target.closest('button[data-consent]');
          if (!b) return;
          var v = b.getAttribute('data-consent');
          save(v);
          box.hidden = true;
          if (v === 'accept') load();
          else if (loaded) {
            // retrait du consentement : on coupe la mesure pour la suite et on supprime les cookies _ga
            window['ga-disable-' + id] = true;
            document.cookie.split(';').forEach(function (c) {
              var n = c.split('=')[0].trim();
              if (n.indexOf('_ga') === 0) document.cookie = n + '=; Max-Age=0; path=/; domain=' + location.hostname;
            });
          }
        });
        document.querySelectorAll('[data-cookie-manage]').forEach(function (m) {
          m.addEventListener('click', function () { box.hidden = false; box.querySelector('button').focus(); });
        });
      })();
    </script>
  </>
)}
