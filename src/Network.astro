---
// Motif « réseau en profondeur » : deux nappes de points reliés (sol et plafond) qui fuient en
// perspective vers un point de fuite décentré, plus des particules flottantes à différentes
// profondeurs. Près : gros, lumineux, dorés, légèrement flous. Loin : petits, bleus, ténus.
// Calculé une fois à la construction (tirage fixe) ; un léger mouvement est ajouté en CSS.
// Variantes : chaque page peut passer sa propre graine (seed), un angle (yaw), un point de fuite
// (cx, cy en fraction de la taille) et un format (w, h) pour obtenir un dessin différent.
const { class: cls = '', seed: seed0 = 11, yaw = 0.42, cx = 0.67, cy = 0.39, w = 600, h = 700, veil: useVeil = true, cols = 15, f: fOverride = 0, spread = 12, rows = 15 } = Astro.props;
const W = w, H = h;
let seed = seed0;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const f1 = (n) => Math.round(n * 10) / 10;

// Caméra : point de fuite décalé vers le haut à droite, nappes légèrement tournées (asymétrie).
const F = fOverride || 470 * (Math.min(W * 1.17, H) / 700), CX = W * cx, CY = H * cy, YAW = yaw, ZMIN = 1.0, ZMAX = 9.5;
const mix = (a, b, t) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
const FAR = [96, 140, 222], NEAR = [244, 202, 98];
const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;

const project = (X, Y, Z) => {
  const x = X * Math.cos(YAW) + Z * Math.sin(YAW);
  const z = -X * Math.sin(YAW) + Z * Math.cos(YAW) + 0.25;
  if (z < ZMIN) return null;
  return { x: CX + (x / z) * F, y: CY + (Y / z) * F, d: Math.min(1, (z - ZMIN) / (ZMAX - ZMIN)) };
};
const inView = (p, m = 60) => p && p.x > -m && p.x < W + m && p.y > -m && p.y < H + m;

// Nappe maillée (sol : sign = 1, plafond : sign = -1).
const COLS = cols, ROWS = rows;
const sheet = (sign, ph) => {
  const g = [];
  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      const X = (c / (COLS - 1) - 0.5) * spread + (rnd() - 0.5) * 0.6;
      const Z = 0.6 + Math.pow(r / (ROWS - 1), 1.35) * 9 + (rnd() - 0.5) * 0.5;
      const Y = sign * (1.55 + 0.55 * Math.sin(X * 0.75 + Z * 0.55 + ph) + 0.35 * Math.cos(Z * 0.95 + ph * 2));
      g.push({ c, r, p: project(X, Y, Z) });
    }
  }
  return g;
};

const links = [];
const nodes = [];
for (const [sign, ph] of [[1, 0.4], [-1, 2.3]]) {
  const g = sheet(sign, ph);
  const at = (c, r) => (c >= 0 && c < COLS && r >= 0 && r < ROWS ? g[r * COLS + c] : null);
  g.forEach((a) => {
    if (!a.p) return;
    if (inView(a.p, 10)) nodes.push(a.p);
    [[1, 0], [0, 1], [a.r % 2 ? 1 : -1, 1]].forEach(([dc, dr]) => {
      const b = at(a.c + dc, a.r + dr);
      if (!b || !b.p) return;
      if (!inView(a.p, 120) && !inView(b.p, 120)) return;
      links.push({ a: a.p, b: b.p });
    });
  });
}

// Particules flottantes (profondeur variée) et quelques liaisons longues.
const floaters = [];
for (let i = 0; i < 60; i++) {
  const p = project((rnd() - 0.5) * 12, (rnd() - 0.5) * 6.5, 0.8 + rnd() * 9);
  if (inView(p, 0)) floaters.push(p);
}
for (let i = 0; i < 16; i++) {
  const a = floaters[Math.floor(rnd() * floaters.length)];
  const b = floaters.filter((q) => q !== a).sort((m, n) => Math.hypot(m.x - a.x, m.y - a.y) - Math.hypot(n.x - a.x, n.y - a.y))[1 + Math.floor(rnd() * 3)];
  if (a && b && Math.hypot(a.x - b.x, a.y - b.y) < 170) links.push({ a, b, long: true });
}

// Voile d'atténuation derrière le logo et le slogan (garde le texte lisible).
const veil = (x, y) => {
  if (!useVeil) return 1;
  const t = Math.hypot((x - W / 2) / (W * 0.36), (y - H * 0.52) / (H * 0.36));
  return 0.26 + 0.74 * Math.max(0, Math.min(1, (t - 0.55) / 0.5));
};

const parts = { far: '', mid: '', near: '' };
const layerOf = (d) => (d < 0.3 ? 'near' : d < 0.62 ? 'mid' : 'far');

links.sort((m, n) => (n.a.d + n.b.d) - (m.a.d + m.b.d)); // lointain d'abord
links.forEach(({ a, b }) => {
  const d = (a.d + b.d) / 2, k = 1 - d;
  const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
  const o = (0.2 + 0.55 * k * k + 0.12 * k) * veil(mx, my);
  if (o < 0.04) return;
  const w = f1(0.5 + 1.7 * k * k);
  parts[layerOf(d)] += `<line x1="${f1(a.x)}" y1="${f1(a.y)}" x2="${f1(b.x)}" y2="${f1(b.y)}" stroke="${rgb(mix(FAR, NEAR, Math.pow(k, 1.6)))}" stroke-opacity="${o.toFixed(2)}" stroke-width="${w}"/>`;
});

const dotOf = (p, big) => {
  const k = 1 - p.d, v = veil(p.x, p.y);
  const col = rgb(mix(FAR, NEAR, Math.pow(k, 1.4)));
  const r = f1((0.9 + 3.6 * k * k) * (big ? 1.4 : 1));
  let s = `<circle cx="${f1(p.x)}" cy="${f1(p.y)}" r="${r}" fill="${col}" fill-opacity="${Math.min(1, (0.3 + 0.7 * k) * v).toFixed(2)}"/>`;
  if (k > 0.62 && v > 0.5) s += `<circle cx="${f1(p.x)}" cy="${f1(p.y)}" r="${f1(r * 4.2)}" fill="${col}" fill-opacity="${(0.16 * v).toFixed(2)}" filter="url(#net-blur)"/>`;
  return s;
};
nodes.sort((m, n) => n.d - m.d).forEach((p) => (parts[layerOf(p.d)] += dotOf(p, false)));
floaters.sort((m, n) => n.d - m.d).forEach((p) => (parts[layerOf(p.d)] += dotOf(p, true)));

// Impulsions lumineuses dorées qui courent le long de quelques liaisons.
const pulses = links
  .filter((l) => !l.long && (l.a.d + l.b.d) / 2 > 0.12 && (l.a.d + l.b.d) / 2 < 0.7 && Math.hypot(l.a.x - l.b.x, l.a.y - l.b.y) > 40 && veil((l.a.x + l.b.x) / 2, (l.a.y + l.b.y) / 2) > 0.8)
  .filter((_, i) => i % 11 === 0)
  .slice(0, 9)
  .map((l, i) => `<line class="pulse" style="animation-duration:${(3.2 + (i % 4) * 0.9).toFixed(1)}s;animation-delay:${(-i * 0.8).toFixed(1)}s" x1="${f1(l.a.x)}" y1="${f1(l.a.y)}" x2="${f1(l.b.x)}" y2="${f1(l.b.y)}" pathLength="100" stroke="#ffe08a" stroke-width="1.8" stroke-linecap="round" stroke-opacity=".95"/>`)
  .join('');

const svg =
  `<svg class="${cls}" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">` +
  `<defs><filter id="net-blur" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="3.2"/></filter></defs>` +
  `<g class="net-far">${parts.far}</g><g class="net-mid">${parts.mid}<g>${pulses}</g></g><g class="net-near">${parts.near}</g></svg>`;
---
<Fragment set:html={svg} />
