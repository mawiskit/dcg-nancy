---
import '../styles/global.css';
import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/dekko/400.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  selfCanonical?: boolean;
  variant?: 'home' | 'doc';
}
const { title, description, noindex: noindexProp = false, selfCanonical = true, variant = 'home' } = Astro.props;
// Indexable par défaut ; la variable NOINDEX=true du déploiement demande aux moteurs de ne pas l'indexer.
const noindex = noindexProp || import.meta.env.PUBLIC_INDEXABLE === 'false';

const gsc = import.meta.env.PUBLIC_GSC_TOKEN;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/images/og-dcg-nancy.jpg`, Astro.site).href;

---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {selfCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#122658" />
    <meta name="geo.region" content="FR-54" />
    <meta name="geo.placename" content="Nancy" />
    <meta name="format-detection" content="telephone=no" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="DCG Nancy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {selfCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Logo DCG Nancy, lycée Georges de la Tour" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
  </head>
  <body class={`page-${variant}`}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <slot />
    <Analytics />
  </body>
</html>
