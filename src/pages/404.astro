---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Page en préparation – DCG Nancy" description="Cette page du site DCG Nancy est en préparation." noindex selfCanonical={false}>
  <Header />
  <main id="contenu" class="soon">
    <h1>Cette page arrive bientôt.</h1>
    <p>Nous terminons cette rubrique. En attendant, retrouvez la présentation du DCG sur la page d’accueil.</p>
    <a class="cta" href={`${base}/`}>RETOUR À L’ACCUEIL</a>
  </main>
  <div></div>
</Base>
