---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Network from '../components/Network.astro';
import SiteLinks from '../components/SiteLinks.astro';
import { temoignages } from '../data/temoignages.js';
import '../styles/decouvrir.css';
import '../styles/temoignages.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.href ?? 'https://dcg-nancy.fr/';
const pageUrl = new URL(`${base}/temoignages/`, Astro.site).href;

const title = 'Témoignages d’étudiants du DCG à Nancy : rythme, matières, ambiance | DCG Nancy';
const description = 'Étudier en DCG à Nancy, vu par ceux qui le vivent : trois étudiants racontent leur arrivée, le rythme, les matières, l’entraide et la vie de promotion.';

/* Données préparées pour l’affichage (la saisie des témoignages se fait dans src/data/temoignages.js). */
const liste = temoignages.map((t, i) => {
  const suffixe = t.annee === 1 ? 're' : 'e';
  const niveau = t.annee ? `DCG ${t.annee}${suffixe} année` : 'Ancien étudiant';
  const ligne = t.roles.length > 0 ? t.roles[0] : t.statut;
  return {
    ...t,
    niveau,
    ligne,
    band: i % 2 === 0 ? 'dd-dark' : 'dd-light',
    accroches: t.accroche ? [t.accroche] : [],
    qa: t.qa.map((x, n) => ({ ...x, num: String(n + 1).padStart(2, '0') })),
  };
});

const next = [
  { t: 'Vie étudiante', s: 'L’association, les sorties et l’esprit de promotion en images.', href: '/vie-etudiante/' },
  { t: 'Découvrir le DCG', s: 'Le programme année par année, les matières et la progression.', href: '/decouvrir-le-dcg/' },
  { t: 'Admissions', s: 'Parcoursup en première année, dossier en deuxième année.', href: '/admissions/' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${site}#site` },
      about: { '@id': `${site}#dcg` },
      breadcrumb: { '@id': `${pageUrl}#fil` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#fil`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: site },
        { '@type': 'ListItem', position: 2, name: 'Témoignages', item: pageUrl },
      ],
    },
  ],
};
---
<Base title={title} description={description} variant="doc">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main id="contenu" class="dd tm">

    <!-- ───────── Introduction ───────── -->
    <section class="dd-hero" aria-labelledby="tm-titre">
      <Network class="network" w={1200} h={600} seed={97} yaw={0.42} cx={0.78} cy={0.5} veil={false} cols={30} rows={13} f={320} spread={34} />
      <div class="dd-wrap dd-hero-in">
        <nav class="dd-crumb" aria-label="Fil d’Ariane">
          <a href={`${base}/`}>Accueil</a><span aria-hidden="true">/</span><span aria-current="page">Témoignages</span>
        </nav>
        <p class="dd-kicker">Parole aux étudiants</p>
        <h1 id="tm-titre">Ils vivent le DCG. <span>Ils en parlent.</span></h1>
        <p class="dd-lead">Qui mieux que nos étudiants pour vous faire découvrir le DCG ? À travers leurs témoignages, découvrez leur parcours, leur quotidien, les exigences de la formation, leurs matières préférées et l’ambiance qui anime les trois promotions. Des expériences personnelles, des conseils et un regard concret sur ces trois années d’études.</p>
        <nav class="dd-jump" aria-label="Les témoignages">
          {liste.map((t) => (
            <a href={`#${t.id}`}>{t.prenom}</a>
          ))}
        </nav>
      </div>
    </section>

    <!-- ───────── Aperçu des témoignages ───────── -->
    <section class="dd-light tm-over" aria-labelledby="tm-h-over">
      <div class="dd-wrap">
        <h2 id="tm-h-over" class="tm-over-h">Trois étudiants, trois regards</h2>
        <ul class="tm-cards">
          {liste.map((t) => (
            <li>
              <a href={`#${t.id}`} data-annee={t.annee} data-profil={t.profil}>
                <span class="tm-ct">{t.niveau}</span>
                <b class="tm-cn">{t.prenom}</b>
                <span class="tm-cl">{t.ligne}</span>
                <span class="tm-cg">Lire le témoignage<svg class="dd-arr" viewBox="0 0 26 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M0 6h24M19 1l5 5-5 5" /></svg></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────── Un témoignage par section ───────── -->
    {liste.map((t) => (
      <section class={`${t.band} tm-sec`} id={t.id} aria-labelledby={`tm-h-${t.id}`}>
        <div class="dd-wrap tm-in">
          <header class="tm-id">
            <p class="tm-niveau">{t.niveau}</p>
            <h2 id={`tm-h-${t.id}`}>{t.prenom}</h2>
            <p class="tm-statut">{t.statut}</p>
            {t.roles.map((r) => (
              <p class="tm-role">{r}</p>
            ))}
            {t.accroches.map((a) => (
              <p class="tm-accroche">{a}</p>
            ))}
            {t.photos.map((p) => (
              <figure class="tm-photo">
                <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
                <figcaption>{p.legende}</figcaption>
              </figure>
            ))}
            {t.videos.map((v) => (
              <figure class="tm-photo">
                <video controls preload="none" playsinline src={v.src} poster={v.poster}></video>
                <figcaption>{v.legende}</figcaption>
              </figure>
            ))}
          </header>

          <div class="tm-body">
            <ol class="tm-qa">
              {t.qa.map((x) => (
                <li>
                  <span class="tm-num" aria-hidden="true">{x.num}</span>
                  <div class="tm-qr">
                    <h3>{x.q}</h3>
                    {x.r.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </li>
              ))}
            </ol>
            <footer class="tm-sign">
              <p class="tm-sig">{t.signature}</p>
              {t.sources.map((s) => (
                <p class="tm-src">Source&#8239;: témoignage publié sur {s.plateforme} le <time datetime={s.datetime}>{s.date}</time> – {s.compte}.</p>
              ))}
            </footer>
          </div>
        </div>
      </section>
    ))}

    <!-- ───────── Aller plus loin ───────── -->
    <section class="dd-dark dd-next" aria-labelledby="tm-h-next">
      <Network class="network" w={1200} h={420} seed={101} yaw={-0.3} cx={0.3} cy={0.5} veil={false} cols={30} rows={12} f={260} spread={32} />
      <div class="dd-wrap dd-next-in">
        <div class="dd-nextl">
          <h2 id="tm-h-next">Envie de les rejoindre&#8239;?</h2>
          <p>Découvrez les modalités d’admission en première et en deuxième année.</p>
          <a class="cta dd-cta" href={`${base}/admissions/`}>CANDIDATER</a>
        </div>
        <ul class="dd-links">
          {next.map((l) => (
            <li>
              <a href={`${base}${l.href}`}>
                <span class="dd-lt">{l.t}</span>
                <span class="dd-ls">{l.s}</span>
                <svg class="dd-arr" viewBox="0 0 26 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M0 6h24M19 1l5 5-5 5" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="doc-footer">
    <p>DCG Nancy · Lycée Georges-de-la-Tour, Nancy</p>
    <p class="doc-links"><SiteLinks /></p>
  </footer>
</Base>
